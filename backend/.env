# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=5000
NODE_ENV=development

# MongoDB — local for now, switch to Atlas connection string later
MONGO_URI=mongodb://127.0.0.1:27017/wellsmerry

# JWT secrets — use long random strings (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=replace_with_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Frontend URL(s) allowed by CORS — comma separated for multiple
CLIENT_URL=http://localhost:5173

# Gmail SMTP for sending OTP emails
# EMAIL_USER = the Wells Merry Gmail address you create
# EMAIL_PASS = a 16-character Gmail "App Password" (NOT your normal Gmail password —
#              generate it from Google Account > Security > 2-Step Verification > App Passwords)
EMAIL_USER=yourbrand@gmail.com
EMAIL_PASS=replace_with_app_password
EMAIL_FROM="Well's Merry <yourbrand@gmail.com>"

# OTP settings
OTP_EXPIRES_MINUTES=15