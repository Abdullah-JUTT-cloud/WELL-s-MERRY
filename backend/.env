# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (free M0 cluster)
MONGO_URI=MONGO_URI=mongodb://127.0.0.1:27017/wellsmerry

# JWT secrets — use long random strings (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=replace_with_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Frontend URL(s) allowed by CORS — comma separated for multiple
CLIENT_URL=http://localhost:5173