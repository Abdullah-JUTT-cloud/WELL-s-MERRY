# Backend API root — MUST end in /api.
#
# Copy to .env for local overrides, and set the same key in the Vercel
# project settings (Production + Preview) so deploys talk to Render.
#
# Correct:   https://well-s-merry.onrender.com/api
# Also fine: https://well-s-merry.onrender.com   (the /api prefix is added
#            automatically by src/api/baseUrl.js)
# Wrong:     https://well-s-merry.onrender.com/api/orders  (trims back to /api)
#
# Leave unset in production and the app falls back to the Render backend.
VITE_API_URL=https://well-s-merry.onrender.com/api
